

# set micro as editor
export EDITOR=micro
export GIT_EDITOR=micro


dc() {
  if [[ -f compose.dev.yml ]]; then
    docker compose -f compose.dev.yml "$@"
  else
    docker compose "$@"
  fi
}

alias rs='rsync -ah --info=progress2'

# get the process(es) running on a port
port() {
  if [ -z "$1" ]; then
    echo "Usage: port <port-number>"
    return 1
  fi
  sudo lsof -iTCP:$1 -sTCP:LISTEN -Pn 2>/dev/null | \
    awk 'NR==1 {printf "%-15s %-8s %-25s %-10s\n", "COMMAND", "PID", "ADDRESS", "PORT"}
         NR>1 {
           split($9, a, ":");
           port=a[length(a)];
           printf "%-15s %-8s %-25s %-10s\n", $1, $2, a[1], port
         }'
}


# please
please() {
    # Get the command *before* 'please' itself
    last_cmd=$(HISTTIMEFORMAT= history 2 | head -n 1 | sed 's/^ *[0-9]* *//')

    if [[ -z "$last_cmd" ]]; then
        echo "No previous command found."
        return 1
    fi
    sudo bash -c "$last_cmd"
}

# project-specific docker compose up
dup() {
  if [[ -f compose.dev.yml ]]; then
    docker compose -f compose.dev.yml up -d --build --force-recreate --remove-orphans
  elif [[ -f docker-compose.yml ]]; then
    xhost +local:docker 2>/dev/null
    docker compose up -d --force-recreate --remove-orphans
  else
    echo "dup: no compose file here (need compose.dev.yml or docker-compose.yml)" >&2
    return 1
  fi
}

ddown() {
  local root repo d stacks_dir
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    dc down "$@"
    return $?
  }
  repo="$(basename "$root")"

  if [[ "$repo" == "dealeros" ]]; then
    (cd "$root" && dc down "$@") || return $?
    stacks_dir="$root/demos/stacks"
    for d in "$stacks_dir"/*/; do
      [[ -d "$d" ]] || continue
      [[ -f "$d/compose.yml" ]] || continue
      docker compose -f "$d/compose.yml" down -v --remove-orphans
    done
    if compgen -G "$stacks_dir"/*/ >/dev/null; then
      sudo rm -rf "$stacks_dir"/*/
    fi
  else
    dc down "$@"
  fi
}

alias drs='docker compose restart browser-worker light-worker heavy-worker'
dlogs() {
  local root repo
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "dlogs: not in a git repository" >&2
    return 1
  }
  repo="$(basename "$root")"
  if [[ "$repo" == "sterling" ]]; then
    dc logs -f private-api public-api browser-worker light-worker heavy-worker "$@"
  else
    dc logs -f "$@"
  fi
}
gt() {
  if [[ -z "$1" ]]; then
    echo "Usage: gt <tag>" >&2
    return 1
  fi

  local reply
  while true; do
    read -r -p "Have you updated the changelog with your changes? [y/n] " reply
    case "$reply" in
      y|Y) break ;;
      n|N)
        echo "Tagging cancelled."
        return 1
        ;;
      *)
        echo "Please answer y or n."
        ;;
    esac
  done

  git tag "$1" && git push origin "$1"
}
